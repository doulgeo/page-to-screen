{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r requirements.txt && (python -m page_to_screen refresh || true)"
  },
  "deploy": {
    "startCommand": "uvicorn page_to_screen.asgi:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
